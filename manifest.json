{
    "manifest_version": 3,
    "name": "ASIN URL Shortener",
    "version": "1.0.0",
    "description": "AmazonのURLを/dp/<ASIN>/形式へ短縮する非公式ツール。外部の短縮サービスは使いません。",
    "homepage_url": "https://github.com/moyashimegane/amazon-url-simple-converter",
    "permissions": [
        "activeTab"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "URLを/dp/<ASIN>/へ短縮",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    }
}
