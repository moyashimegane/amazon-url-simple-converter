{
    "manifest_version": 3,
    "name": "amazonUrlSimpleConverter",
    "version": "1.0.0",
    "description": "Click to rewrite current Amazon tab to https://www.amazon.co.jp/dp/ASIN/",
    "permissions": [
        "activeTab"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "Amazon URLを /dp/ に正規化",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    }
}